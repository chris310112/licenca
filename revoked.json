<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gerador de licenças Mr. Totem</title>
<style>body{font-family:Arial,sans-serif;max-width:920px;margin:20px auto;padding:0 14px;color:#111}input,button{font:inherit;padding:9px;margin:4px 0;width:100%;box-sizing:border-box}button{width:auto;cursor:pointer;padding:8px 12px;margin-right:6px}.g{display:grid;grid-template-columns:1fr 1fr;gap:10px}table{width:100%;border-collapse:collapse;font-size:13px}td,th{border-bottom:1px solid #ddd;padding:6px;text-align:left}code{word-break:break-all;background:#f3f4f6;padding:8px;display:block;margin:10px 0}.r{color:#b91c1c;font-weight:700}.warn{background:#fef2f2;border:1px solid #dc2626;padding:10px;border-radius:8px}@media(max-width:600px){.g{grid-template-columns:1fr}}</style></head><body>
<h1>Gerador de licenças Mr. Totem</h1><p class="warn">⚠️ Este arquivo contém a chave privada. Guarde só com você e nunca entregue a clientes.</p>
<div class="g"><div><label>Cliente</label><input id="c"></div><div><label>Nome do totem</label><input id="t"></div><div><label>ID do totem (aparece na tela de ativação)</label><input id="d"></div><div><label>Pago até</label><input id="e" type="date"></div><div><label>Dias de carência após o vencimento</label><input id="g" type="number" value="5"></div><div><label>Link do revoked.json (opcional, desliga à distância)</label><input id="u" placeholder="https://..."></div></div>
<button onclick="gen()">Gerar serial</button><code id="out">O serial aparece aqui.</code>
<h2>Licenças emitidas</h2><table id="tb"></table><p><b>Conteúdo do revoked.json</b> (copie e cole no GitHub)</p><textarea id="rv" readonly style="width:100%;height:90px;font:inherit"></textarea><p><button onclick="navigator.clipboard&&navigator.clipboard.writeText($('rv').value)">Copiar</button><button onclick="dlRev()">Baixar arquivo</button></p>
<p>Desligar à distância: marque "Desligar", baixe o revoked.json e publique no link informado ao gerar o serial. Sem link, o desligamento acontece no vencimento + carência (não emita renovação).</p>
<script>
const PRIV={"key_ops": ["sign"], "ext": true, "kty": "EC", "x": "HmdqGDLJ11oTFjIA-DulZC_0yuIvHXyb6BW1TWjRKUI", "y": "p4fw562KDTKN4TIDSXB9hvFlcJvK9uYtgyDma8QQhBo", "crv": "P-256", "d": "lvIkVErh9QzTrZajbGAKwyG_EyvS18Cvklq_pW_aAAo"},$=id=>document.getElementById(id);let L=JSON.parse(localStorage.getItem('mtLic')||'[]');
const b64=b=>btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
async function sign(o){const pl=new TextEncoder().encode(JSON.stringify(o)),k=await crypto.subtle.importKey('jwk',PRIV,{name:'ECDSA',namedCurve:'P-256'},false,['sign']);return 'MT1.'+b64(pl)+'.'+b64(await crypto.subtle.sign({name:'ECDSA',hash:'SHA-256'},k,pl))}
async function gen(){const c=$('c').value.trim(),t=$('t').value.trim(),d=$('d').value.trim(),e=$('e').value;if(!c||!t||!d||!e)return alert('Preencha cliente, totem, ID do totem e data.');
let x=L.find(v=>v.d===d);const o={i:x?x.i:'L'+Date.now().toString(36),c,t,d,e,g:+$('g').value||0,u:$('u').value.trim()||undefined};o.serial=await sign(o);
if(x)Object.assign(x,o);else L.push(x={...o,revoked:false});localStorage.setItem('mtLic',JSON.stringify(L));$('out').textContent=o.serial;render()}
function render(){$('tb').innerHTML='<tr><th>Cliente</th><th>Totem</th><th>Pago até</th><th>Status</th><th></th></tr>'+L.map((x,i)=>`<tr><td>${x.c}</td><td>${x.t}<br><small>${x.d}</small></td><td>${x.e}</td><td class="${x.revoked?'r':''}">${x.revoked?'Desligado':'Ativo'}</td><td><button onclick="cp(${i})">Copiar serial</button><button onclick="ed(${i})">Renovar</button><button onclick="tg(${i})">${x.revoked?'Reativar':'Desligar'}</button></td></tr>`).join('');$('rv').value=JSON.stringify({revoked:L.filter(x=>x.revoked).map(x=>x.i)})}
const cp=i=>{navigator.clipboard?.writeText(L[i].serial);$('out').textContent=L[i].serial};
function ed(i){const x=L[i];$('c').value=x.c;$('t').value=x.t;$('d').value=x.d;$('g').value=x.g;$('u').value=x.u||'';$('e').value='';scrollTo(0,0)}
function tg(i){L[i].revoked=!L[i].revoked;localStorage.setItem('mtLic',JSON.stringify(L));render()}
function dlRev(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({revoked:L.filter(x=>x.revoked).map(x=>x.i)})],{type:'application/json'}));a.download='revoked.json';a.click()}
render();
</script></body></html>
